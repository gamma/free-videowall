    "build:tizen-image": "python3 scripts/tizen_docker.py image"
  },
  "devDependencies": {
    "brighterscript": "0.73.8",
    "brs": "0.39.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
