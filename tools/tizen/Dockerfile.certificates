# Optional companion to the build image; contains no account data or private keys.
FROM node:22-bookworm-slim AS node
FROM free-videowall/tizen-sdk:10.0
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    dbus-x11 gnome-keyring socat \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
ARG SAMSUNG_TOOLS_COMMIT=431ae2b47684016748330eac2ba4eb4167ad4319
RUN wget -q --https-only -O /tmp/samsung-tools.tar.gz \
    "https://codeload.github.com/Samsung/tizen-agent-skills/tar.gz/${SAMSUNG_TOOLS_COMMIT}" \
    && mkdir -p /opt/samsung-source \
    && tar -xzf /tmp/samsung-tools.tar.gz -C /opt/samsung-source --strip-components=1 \
    && rm /tmp/samsung-tools.tar.gz
# The user opens the URL printed by Samsung's CLI. Never launch a host browser.
RUN printf '#!/bin/sh\nexit 0\n' > /usr/local/bin/xdg-open \
    && chmod 755 /usr/local/bin/xdg-open \
    && install -d -m 700 -o developer -g developer /home/developer/.local/share/keyrings
COPY certificate-service.sh /usr/local/bin/tizen-certificate-service
RUN chmod 755 /usr/local/bin/tizen-certificate-service
ENV DBUS_SESSION_BUS_ADDRESS=unix:path=/tmp/tizen-dbus
USER developer
RUN printf '/home/developer/tizen-studio\n' > /home/developer/.tizen.sdk.path.config
ENTRYPOINT ["/usr/local/bin/tizen-certificate-service"]
